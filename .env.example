APP_NAME=PassportAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

VITE_APP_NAME="${APP_NAME}"

# Remove.bg API key (https://www.remove.bg/api)
# Leave empty to use the dev fallback (white background composite)
REMOVE_BG_API_KEY=

# Local Python AI pipeline (ai-system/) — set to http://localhost:8000 when running
AI_PIPELINE_URL=

# Free cloud AI background removal (Hugging Face)
HUGGINGFACE_TOKEN=

# Incode Omni face detection (https://demo-api.incodesmile.com)
# Set INCODE_ENABLED=false to skip Incode and use the built-in skin-tone detector
INCODE_ENABLED=true
INCODE_API_KEY=

# Optional: OpenAI API key for AI-powered chatbot error explanations
# Leave empty to use rule-based message fallback
OPENAI_API_KEY=
